### OURFW v0.6 - TP-Link EC220-G5 v2
CONFIG_VENDOR=TPLINK
CONFIG_PRODUCT=MT7620
CONFIG_FIRMWARE_PRODUCT_ID="TL_EC220_G5-V2"

### Hardware / radio - exact known-good EC220 base
CONFIG_FIRMWARE_CPU_600MHZ=y
CONFIG_FIRMWARE_WIFI5_DRIVER=3.0
CONFIG_FIRMWARE_WIFI2_DRIVER=2.7

### Network core
CONFIG_FIRMWARE_ENABLE_IPV6=y
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y

### UI / administration
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y

### v0.6 secure administration / compatibility built-ins
CONFIG_FIRMWARE_INCLUDE_HTTPS=y
CONFIG_FIRMWARE_INCLUDE_SFTP=y
CONFIG_FIRMWARE_INCLUDE_OPENVPN=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y
CONFIG_FIRMWARE_INCLUDE_ZRAM=y
# AdBlock Lite updater needs an HTTPS-capable fetcher. OpenSSL is already present.
CONFIG_FIRMWARE_INCLUDE_CURL=y

### OURFW VPN / DPI built-ins
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y
CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y
CONFIG_FIRMWARE_INCLUDE_NFQWS=y

### nfqws kernel queue support
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_IP_NF_QUEUE=m
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MANGLE=m
CONFIG_BRIDGE_NF_EBTABLES=m

### Deliberately still excluded in v0.6:
### StrongSwan, DNSCrypt/Stubby/DoH, xUPNPd, Lua, EoIP, VLMCSD,
### Socat, Tor/Privoxy and CAKE/FQ-CoDel. Re-evaluate after hardware measurements.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
